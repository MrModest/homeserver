function d-logs() { # '2>&1' because containers write most logs to stderr
  if command -v hl > /dev/null; then
    docker logs "$@" 2>&1 | hl
  else
    docker logs "$@" 2>&1 | batcat --wrap=never
  fi
}

function d-logs-f() {
  if command -v hl > /dev/null; then
    docker logs -f "$@" 2>&1 | hl --paging=never
  else
    docker logs -f "$@" 2>&1
  fi
}

function d-sh() {
  docker exec -it $1 sh
}

function d-root-sh() {
  docker exec -it --user 0 $1 sh
}

function d-bash() {
  docker exec -it $1 bash
}

function d-root-bash() {
  docker exec -it --user 0 $1 bash
}

function d-envs() {
  docker exec $1 env
}

function cd-apps() {
  cd {{ p_dirs.apps_data }}/$1
}

function cd-compose() {
  cd {{ p_dirs.compose_files }}/$1
}

if [ -n "$BASH_VERSION" ]; then
  function _complete_subdirs_of() {
    local base="$1"
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local dir

    COMPREPLY=()
    while IFS= read -r dir; do
      COMPREPLY+=("${dir#$base/}/")
    done < <(compgen -d -- "$base/$cur")

    compopt -o nospace
  }

  function _complete_cd_apps() {
    _complete_subdirs_of '{{ p_dirs.apps_data }}'
  }

  function _complete_cd_compose() {
    _complete_subdirs_of '{{ p_dirs.compose_files }}'
  }

  complete -F _complete_cd_apps cd-apps
  complete -F _complete_cd_compose cd-compose

  function _complete_running_containers() {
    local names=$(docker ps --format {% raw %}'{{.Names}}'{% endraw %} 2> /dev/null)
    COMPREPLY=($(compgen -W "$names" -- "${COMP_WORDS[COMP_CWORD]}"))
  }

  function _complete_all_containers() {
    local names=$(docker ps -a --format {% raw %}'{{.Names}}'{% endraw %} 2> /dev/null)
    COMPREPLY=($(compgen -W "$names" -- "${COMP_WORDS[COMP_CWORD]}"))
  }

  complete -F _complete_running_containers d-sh d-root-sh d-bash d-root-bash d-envs
  complete -F _complete_all_containers d-logs d-logs-f d-container-restart

  function _complete_d_db_dump() {
    if [ "$COMP_CWORD" -eq 1 ]; then
      local apps=$(cd '{{ p_dirs.compose_files }}' 2> /dev/null && compgen -d)
      COMPREPLY=($(compgen -W "$apps" -- "${COMP_WORDS[COMP_CWORD]}"))
    else
      _complete_running_containers
    fi
  }

  complete -F _complete_d_db_dump d-db-dump
  complete -W 'list start stop' docker-compose-all

  function _complete_command_wrapper() { # '_command' come from bash-completion, loaded after this file
    if declare -F _command > /dev/null; then
      _command
    else
      COMPREPLY=($(compgen -c -- "${COMP_WORDS[COMP_CWORD]}"))
    fi
  }

  complete -F _complete_command_wrapper -o default sapp

  function _complete_paths_as_root() { # list via 'sudo', so dirs without o+x still complete
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local dir=''

    case "$cur" in
      */*) dir="${cur%/*}/" ;;
    esac

    COMPREPLY=($(compgen -P "$dir" -W "$(sudo ls -1Ap "${dir:-.}" 2> /dev/null)" -- "${cur##*/}"))

{% raw %}    if [ "${#COMPREPLY[@]}" -eq 1 ] && [[ "${COMPREPLY[0]}" == */ ]]; then{% endraw %}
      compopt -o nospace
    fi
  }

  complete -F _complete_paths_as_root sll stree sbat
fi

function d-db-dump() {
  local dumps_root='{{ p_dirs.backups_root }}/db_dumps'

  local app_name=$1
  local container_name=$2
  local timestamp=$(date +%Y-%m-%d_%H-%M-%S)
  local yesterday=$(date --date="yesterday" -u +"%Y-%m-%d")
  local dump_path="$dumps_root/$app_name/dump-$container_name-$timestamp.sql.gz"

  sudo mkdir -p $dumps_root/$app_name
  sudo chown -R {{ p_apps_user.user }}:{{ p_apps_user.group }} $dumps_root/$app_name

  echo "Running 'pg_dumpall -c -U postgres' for $2 of $1 at $timestamp"

  docker exec -t $container_name pg_dumpall -c -U postgres | gzip > "$dump_path"\
   && echo "Database dump saved to $dump_path"\
   && echo "Removing dumps from $yesterday"\
   && sudo find "$dumps_root/$app_name" -maxdepth 1 -name "dump-$container_name-${yesterday}_*" -print -delete

  sudo chown -R {{ p_apps_user.user }}:{{ p_apps_user.group }} $dumps_root/$app_name
}

function docker-compose-all() {
  local compose_files_path="{{ p_dirs.compose_files }}/*/compose.yml"
  local sed_regexp=".*compose-files\/\(.*\)\/compose.yml"

  local app_list=$(find $compose_files_path | sed "s/$sed_regexp/- \1/")

  local prompt_msg="unset"
  local final_cmd="unset"
  case "$1" in
    "list")
      echo "$app_list"
      return
      ;;
    "start")
      echo "It will START all following apps:"
      echo "$app_list"
      final_cmd="find $compose_files_path | xargs -I {} docker compose -f {} up -d"
      ;;
    "stop")
      echo "It will STOP all following apps:"
      echo "$app_list"
      final_cmd="find $compose_files_path | xargs -I {} docker compose -f {} down"
      ;;
    *)
      echo "Usage: docker-compose-all (list|start|stop)"
      return 1
      ;;
  esac

  read -p "Continue? [Y/n] " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]
  then
    eval "$final_cmd"
  fi
}

function docker-used-volumes() {
  for v in $(docker volume ls --format {% raw %}'{{.Name}}'{% endraw %})
  do
    containers="$(docker ps -a --filter volume=$v --format {% raw %}'{{.Names}}'{% endraw %})"
    echo "volume $v is used by $containers"
  done
}

function docker-overlay-ls() {
  docker inspect $(docker ps -qa) |  jq -r 'map([.Name, .GraphDriver.Data.MergedDir]) | .[] | "\(.[0])\t\(.[1])"' | column -t
}

function zfs-docker-cleanup() {
  local snapshots_count=$(sudo zfs get mounted | grep "mounted   no" | grep "fast/docker/data-root" | awk '{print $1}' | wc -l)

  echo "Docker lagacy snapshots before: $snapshots_count"
  sudo zfs get mounted | grep "mounted   no" | grep "fast/docker/data-root" | awk '{print $1}' | xargs -I {} sudo zfs destroy {} -R

  snapshots_count=$(sudo zfs get mounted | grep "mounted   no" | grep "fast/docker/data-root" | awk '{print $1}' | wc -l)
  echo "Docker lagacy snapshots after: $snapshots_count"
}

function smartctl-selftest-status(){
  sudo smartctl -aj $1 | jq .ata_smart_data.self_test.status
}
