// Managed by Ansible: roles/setup_observability/templates/config.alloy.j2
// Replaces the former Promtail config; Promtail reached end of life 2026-03-02.

logging {
  level  = "warn"
  format = "logfmt"
}

// ----------------------------------------------------------------- logs

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

local.file_match "varlogs" {
  path_targets = [{
    __path__ = "/var/log/*log",
    job      = "varlogs",
  }]
}

loki.source.file "varlogs" {
  targets    = local.file_match.varlogs.targets
  forward_to = [loki.write.default.receiver]
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// Serves double duty: .output filters the discovered targets, .rules is applied
// to each log entry, which is where __meta_docker_container_log_stream appears.
discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "logstream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.container_logs.output
  relabel_rules = discovery.relabel.container_logs.rules
  forward_to    = [loki.write.default.receiver]
}

// -------------------------------------------------------------- metrics

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// cAdvisor only refreshes its stats every {{ obs_cadvisor_housekeeping_interval }};
// scraping faster than that just re-reads identical values.
prometheus.scrape "cadvisor" {
  targets = [
    { __address__ = "cadvisor:8080", job = "cadvisor" },
  ]
  scrape_interval = "{{ obs_cadvisor_scrape_interval }}"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "infra" {
  targets = [
    { __address__ = "loki:3100", job = "loki" },
    { __address__ = "host.docker.internal:9323", job = "docker" },
    { __address__ = "host.docker.internal:9100", job = "node" },
    { __address__ = "immich_server:8081", job = "immich_api" },
    { __address__ = "immich_server:8082", job = "immich_microservices" },
{% for t in obs_extra_scrape_targets %}
    { __address__ = "{{ t.address }}", job = "{{ t.job }}" },
{% endfor %}
  ]
  scrape_interval = "{{ obs_scrape_interval }}"
  scrape_timeout  = "{{ obs_scrape_timeout }}"
  forward_to      = [prometheus.remote_write.local.receiver]
}
