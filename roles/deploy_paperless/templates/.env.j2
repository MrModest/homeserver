APP_VERSION={{ ppls_app_version }}
REDIS_VERSION={{ ppls_redis_version }}
POSTGRES_VERSION={{ ppls_postgres_version }}
GOTENBERG_VERSION={{ ppls_gotenberg_version }}
TIKA_VERSION={{ ppls_tika_version }}

APP_USER=root
APP_GROUP=root
APP_DATA_PATH={{ p_dirs.apps_data }}/paperless
DATA_PATH={{ p_dirs.slow_data }}/paperless
SMB_PATH={{ p_dirs.smb_root }}/paperless

SECRET_KEY={{ ppls_secretkey }}
APP_DOMAIN=https://{{ ppls_app_host }}
APP_ADMIN_PASSWORD={{ ppls_admin_password }}

PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS='{{ {"openid_connect": {"OAUTH_PKCE_ENABLED": true, "APPS": [{"provider_id": "authentik", "name": "authentik", "client_id": ppls_oidc.client_id, "secret": ppls_oidc.client_secret, "settings": {"server_url": "https://" ~ ppls_oidc.issuer ~ "/application/o/paperless/.well-known/openid-configuration", "fetch_userinfo": true}}], "SCOPE": ["openid", "profile", "email"]}} | to_json }}'
PAPERLESS_SOCIAL_AUTO_SIGNUP=false
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=false

TZ={{ p_timezone }}

COMPOSE_PROJECT_NAME=paperless
