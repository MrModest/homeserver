HERMES_VERSION={{ hnts_hermes_version }}
HATCHDOOR_VERSION={{ hnts_hatchdoor_version }}

APP_DATA_PATH={{ p_dirs.apps_data }}/hermes_notes
HERMES_UID={{ hnts_hermes_uid }}
HERMES_GID={{ hnts_hermes_gid }}

# --- Telegram (get token from @BotFather, numeric ID from @userinfobot) ---
TELEGRAM_BOT_TOKEN={{ hnts_telegram_bot_token }}
TELEGRAM_ALLOWED_USERS={{ hnts_telegram_allowed_users }}

# --- LLM provider (CLIProxyAPI) ---
HERMES_CODEX_BASE_URL={{ hnts_hermes_codex_base_url }}

# --- Hatchdoor: web UI auth ---
# Required even though no host port is published: docker compose binds
# Hatchdoor to 0.0.0.0 inside the container, and Hatchdoor refuses
# non-loopback binds without this set.
HATCHDOOR_WEB_BEARER_TOKEN={{ hnts_hatchdoor_web_bearer_token }}

# --- Hatchdoor: MCP ---
HATCHDOOR_MCP_ENABLED={{ hnts_hatchdoor_mcp_enabled }}
HATCHDOOR_MCP_WRITE_ENABLED={{ hnts_hatchdoor_mcp_write_enabled }}
HATCHDOOR_MCP_BEARER_TOKEN={{ hnts_hatchdoor_mcp_bearer_token }}
# Since v2.4.0 attachments are uploaded directly by the agent (base64 via the
# import_attachment MCP tool, or multipart POST /api/attachment) — there is no
# shared staging dir any more. This caps the decoded size of a base64 upload.
HATCHDOOR_MCP_MAX_BASE64_BYTES={{ hnts_hatchdoor_mcp_max_base64_bytes }}
# Cap for multipart uploads, which is the path file-relay actually uses.
HATCHDOOR_MAX_ATTACHMENT_BYTES={{ hnts_hatchdoor_max_attachment_bytes }}

# --- file-relay (see compose.yml) ---
RELAY_SOURCE_DIR=/files
# hermes tells the agent its own container path ("[Image attached at:
# /opt/data/cache/images/img_xxx.jpg]"); the relay sees that tree at /files.
RELAY_AGENT_ROOT=/opt/data/cache
RELAY_UPLOAD_URL={{ hnts_relay_upload_url }}
# Hatchdoor's /api/attachment accepts the MCP token as well as the web one.
RELAY_UPLOAD_TOKEN={{ hnts_hatchdoor_mcp_bearer_token }}
RELAY_FILE_FIELD=file
RELAY_PATH_FIELD=target_relative_path
# Every attachment lands here; the agent never picks a destination.
RELAY_TARGET_DIR={{ hnts_relay_target_dir }}
# hermes caches documents as `doc_<12 hex>_<original name>` to keep them unique
# on disk; the vault should get the original name back.
RELAY_STRIP_NAME_PREFIX=^doc_[0-9a-f]{12}_
RELAY_MAX_BYTES={{ hnts_hatchdoor_max_attachment_bytes }}

# --- Hatchdoor: git sync (disaster recovery — commits+pushes ~30s after each write) ---
HATCHDOOR_GIT_SYNC_ENABLED={{ hnts_hatchdoor_git_sync_enabled }}
HATCHDOOR_GIT_REMOTE={{ hnts_hatchdoor_git_remote }}
HATCHDOOR_GIT_BRANCH={{ hnts_hatchdoor_git_branch }}
HATCHDOOR_GIT_HTTPS_USERNAME={{ hnts_github_username }}
# Fine-grained GitHub PAT scoped ONLY to knowledge-vault, Contents: Read & Write
HATCHDOOR_GIT_HTTPS_TOKEN={{ hnts_github_pat }}
HATCHDOOR_GIT_DEBOUNCE_SECONDS={{ hnts_hatchdoor_git_debounce_seconds }}
HATCHDOOR_GIT_AUTHOR_NAME={{ hnts_hatchdoor_git_author_name }}
HATCHDOOR_GIT_AUTHOR_EMAIL={{ hnts_hatchdoor_git_author_email }}
