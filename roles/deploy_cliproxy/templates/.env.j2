COMPOSE_PROJECT_NAME=cliproxy

APP_DATA_PATH={{ p_dirs.apps_data }}/cliproxy
TIMEZONE={{ p_timezone }}

CLI_PROXY_API_VERSION={{ cpa_cliproxy_version }}
CPA_MANAGER_VERSION={{ cpa_manager_version }}
OPEN_WEBUI_VERSION={{ cpa_open_webui_version }}

# Set explicitly so a first start doesn't mint a random admin key that is
# printed once to the container log and then only recoverable by resetting it.
CPA_MANAGER_ADMIN_KEY={{ cpa_manager_admin_key }}
# Hands CPAMP its CPA connection up front, so the panel needs no setup wizard.
CPA_UPSTREAM_URL=http://cli-proxy-api:8317
CPA_MANAGEMENT_KEY={{ cpa_management_key }}

# Open WebUI reaches the proxy as an ordinary OpenAI-compatible client.
OPEN_WEBUI_API_KEY={{ cpa_api_key }}
OPEN_WEBUI_URL=https://{{ cpa_open_webui_host }}
OPEN_WEBUI_SECRET_KEY={{ cpa_open_webui_secret_key }}
OPEN_WEBUI_ENABLE_SIGNUP={{ cpa_open_webui_enable_signup | string }}
